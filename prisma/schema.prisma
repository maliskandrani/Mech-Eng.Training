// Prisma schema for the training platform (courses, trainers, students)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TRAINER
  STUDENT
}

enum MaterialType {
  BOOK
  VIDEO
  SLIDE
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Designation {
  NONE
  ENGINEER
  DOCTOR
  PROFESSOR
}

enum PaymentMethod {
  BANK_TRANSFER
  LIBYANA_CARD
  MADAR_CARD
  LTT_CARD
  CASH_OFFICE
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  APPROVED
  REJECTED
}

model User {
  id           String      @id @default(cuid())
  name         String
  nameEn       String? // English name shown on non-Arabic pages; Arabic pages always use `name`
  designation  Designation @default(NONE) // prefixed before the Arabic name only (م./د./أ.)
  email        String      @unique
  passwordHash String
  role         Role        @default(STUDENT)
  avatarUrl    String?
  title        String? // professional title shown on trainer profile
  titleEn      String?
  bio          String?
  bioEn        String?
  phone        String?
  socialUrl    String? // Facebook / social media profile link or handle
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  coursesTaught     Course[]          @relation("TrainerCourses")
  enrollments       Enrollment[]
  reviews           Review[]
  purchaseRequests  PurchaseRequest[] @relation("BuyerPurchases")
  receivedPurchases PurchaseRequest[] @relation("ReceivedPurchases")
  approvedPurchases PurchaseRequest[] @relation("ApprovedPurchases")

  @@map("users")
}

model Category {
  id      String   @id @default(cuid())
  slug    String   @unique
  name    String
  nameEn  String?
  courses Course[]

  @@map("categories")
}

model Course {
  id            String      @id @default(cuid())
  slug          String      @unique
  title         String
  titleEn       String?
  subtitle      String?
  subtitleEn    String?
  description   String?
  descriptionEn String?
  posterUrl     String?
  introVideoUrl String?
  totalHours    Float?
  price         Float       @default(0)
  level         CourseLevel @default(BEGINNER)
  published     Boolean     @default(false)
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  trainerId  String
  trainer    User     @relation("TrainerCourses", fields: [trainerId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  sections         Section[]
  enrollments      Enrollment[]
  reviews          Review[]
  purchaseRequests PurchaseRequest[]

  @@map("courses")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("reviews")
}

model Section {
  id            String  @id @default(cuid())
  title         String
  titleEn       String?
  order         Int     @default(0)
  coverImageUrl String?
  courseId      String
  course        Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  @@map("sections")
}

model Lesson {
  id            String  @id @default(cuid())
  title         String
  titleEn       String?
  order         Int     @default(0)
  coverImageUrl String?
  sectionId     String
  section       Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  materials Material[]

  @@map("lessons")
}

model Material {
  id              String       @id @default(cuid())
  title           String
  type            MaterialType
  fileUrl         String
  fileSize        Int?
  durationMinutes Int?
  order           Int          @default(0)
  /// Null or 0 = free for any logged-in user; otherwise the price (in the site's currency) shown for this item.
  price           Float?
  createdAt       DateTime     @default(now())

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  purchaseRequests PurchaseRequest[]

  @@map("materials")
}

// A manual, offline-payment purchase — bank transfer, a Libyana/Madar/LTT
// recharge card, or cash at an office. Approval requires two steps: the
// receiver (course-owning trainer, or admin) confirms the money arrived,
// then admin gives the final approval that actually unlocks access.
model PurchaseRequest {
  id              String         @id @default(cuid())
  amount          Float
  paymentMethod   PaymentMethod
  proofUrl        String
  note            String?
  status          PurchaseStatus @default(PENDING)
  rejectionReason String?
  receivedAt      DateTime?
  approvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  userId String
  user   User   @relation("BuyerPurchases", fields: [userId], references: [id], onDelete: Cascade)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Cascade)

  receivedById String?
  receivedBy   User?   @relation("ReceivedPurchases", fields: [receivedById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("ApprovedPurchases", fields: [approvedById], references: [id])

  @@map("purchase_requests")
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  progress    Int      @default(0)
  enrolledAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

// Singleton row (id = "main") holding site-wide branding assets.
model SiteSettings {
  id        String  @id @default("main")
  logoUrl   String?
  currency  String  @default("LYD") // ISO 4217 code: LYD, EGP, or USD
  homeViews Int     @default(0) // simple homepage load counter, not unique-visitor analytics

  // Free-form instructions shown to a buyer on the purchase page for each
  // payment channel; admin-edited, null/empty means that channel isn't offered.
  paymentBankDetails    String?
  paymentLibyanaInfo    String?
  paymentMadarInfo      String?
  paymentLttInfo        String?
  paymentCashOfficeInfo String?

  @@map("site_settings")
}

// Small image gallery telling the academy's story on the homepage.
model StoryImage {
  id        String   @id @default(cuid())
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("story_images")
}

enum ContactMessageType {
  COMPLAINT
  SUGGESTION
  INQUIRY
}

// Messages submitted through the public /contact page.
model ContactMessage {
  id          String             @id @default(cuid())
  name        String
  contactInfo String // email or phone the sender provided
  type        ContactMessageType @default(INQUIRY)
  message     String
  read        Boolean            @default(false)
  createdAt   DateTime           @default(now())

  @@map("contact_messages")
}
