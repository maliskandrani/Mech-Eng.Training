# Local dev database (SQLite). Swap for a Postgres URL in production,
# e.g. postgresql://user:password@host:5432/dbname
#
# IMPORTANT: use an ABSOLUTE path for the sqlite file, not a relative one.
# Prisma's CLI (migrate/seed) resolves a relative "file:./dev.db" path relative
# to the prisma/ folder, while the compiled app at runtime resolves it relative
# to the process's working directory — those are two different locations, so a
# relative path silently reads/writes two different database files. Point both
# at the same absolute path to avoid this, e.g.:
DATABASE_URL="file:/absolute/path/to/project/prisma/dev.db"

# Auth.js secret used to sign session tokens. Generate a new one for production:
# openssl rand -base64 32
AUTH_SECRET="change-me"

# Absolute or relative directory where uploaded course materials are stored.
UPLOAD_DIR="./storage/uploads"

# Set this to your production domain (e.g. https://your-domain.com) once deployed.
# AUTH_URL="https://your-domain.com"
